<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Thème de base de l'application. -->
    <style name="Theme.HealthConnect" parent="Theme.Material3.DayNight.NoActionBar"> <!-- Nous utilisons Material3 et NoActionBar pour plus de contrôle avec Jetpack Compose -->

        <!-- Couleurs primaires (utilisées pour les éléments importants comme les boutons, les liens...) -->
        <item name="colorPrimary">@color/blue_medium</item>      <!-- Votre couleur principale -->
        <item name="colorOnPrimary">@color/white</item>         <!-- Texte sur la couleur principale -->

        <!-- Couleurs secondaires (utilisées pour les filtres, les interrupteurs...) -->
        <item name="colorSecondary">@color/green_teal</item>    <!-- Votre couleur secondaire -->
        <item name="colorOnSecondary">@color/white</item>       <!-- Texte sur la couleur secondaire -->

        <!-- Couleur de fond principale de l'application -->
        <item name="android:colorBackground">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnBackground">@color/black</item>
        <item name="colorOnSurface">@color/black</item>

        <!-- Couleur de la barre de statut en haut -->
        <item name="android:statusBarColor">@color/blue_dark</item>

    </style>
</resources>
